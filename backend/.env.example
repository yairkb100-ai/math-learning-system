# Copy to .env and fill in values (local dev). In production set these as
# environment variables on the host (Railway).

# JWT signing secret — MUST be a long random string in production.
SECRET_KEY=change-me-in-production

# Postgres connection string. Leave unset locally to use the bundled SQLite file.
# Railway's Postgres plugin exposes this automatically as ${{ Postgres.DATABASE_URL }}.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated list of allowed frontend origins for CORS (production domain).
# CORS_ORIGINS=https://math-learning.vercel.app

# Initial admin password created by seed.py (defaults to admin123 if unset).
# ADMIN_PASSWORD=choose-a-strong-password

# Directory for uploaded files. Only used as a local-dev fallback when the
# CLOUDFLARE_R2_* vars below are unset — production always uses R2.
# UPLOAD_DIR=/data/uploads

# Cloudflare R2 (S3-compatible object storage) — all uploads go here in
# production. See dash.cloudflare.com → R2 → your bucket → Settings.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_URL=https://files.example.com
